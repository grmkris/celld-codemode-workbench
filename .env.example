# Shared secret for HMAC session tokens. Required for every non-health route.
AUTH_SECRET=dev-change-me

# Deterministic fixture (default) or a live provider.
# fixture | alibaba | openai | grok
MODEL_PROVIDER=fixture

# Alibaba Cloud Token Plan (OpenAI-compatible chat/completions).
# Optional local file: ~/.config/secrets.env (never commit the value).
# `npm run dev` loads it when present.
ALIBABA_TOKEN_PLAN_API_KEY=
ALIBABA_MODEL=qwen3.8-max

# Used only when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Used only when MODEL_PROVIDER=grok
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning

# Enable crash/recovery test hooks. Never enable on a shared fleet.
ALLOW_TEST_HOOKS=0
